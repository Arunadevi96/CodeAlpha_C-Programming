#include <iostream>
#include <vector>
#include <ctime>
#include <iomanip>
using namespace std;

// Transaction Class
class Transaction {
public:
    string type;
    double amount;
    string timestamp;

    Transaction(string t, double a) : type(t), amount(a) {
        time_t now = time(0);
        timestamp = ctime(&now);
        timestamp.pop_back(); // remove trailing newline
    }

    void display() const {
        cout << type << " Rs " << amount << " on " << timestamp << endl;
    }
};

// Account Class
class Account {
    static int nextAccNo;
public:
    int accountNumber;
    double balance;
    vector<Transaction> history;

    Account() {
        accountNumber = ++nextAccNo;
        balance = 0;
    }

    void deposit(double amount) {
        balance += amount;
        history.emplace_back("Deposit", amount);
        cout << "Rs " << amount << " deposited successfully!" << endl;
    }

    void withdraw(double amount) {
        if (amount > balance) {
            cout << "Insufficient funds!" << endl;
            return;
        }
        balance -= amount;
        history.emplace_back("Withdraw", amount);
        cout << "Rs " << amount << " withdrawn successfully!" << endl;
    }

    void transfer(Account &to, double amount) {
        if (amount > balance) {
            cout << "Transfer failed! Insufficient balance." << endl;
            return;
        }
        balance -= amount;
        to.balance += amount;
        history.emplace_back("Transfer to Acc" + to_string(to.accountNumber), amount);
        to.history.emplace_back("Transfer from Acc" + to_string(accountNumber), amount);
        cout << "Transferred Rs " << amount << " to Acc" << to.accountNumber << endl;
    }

    void showHistory() const {
        cout << "Transaction History for Account " << accountNumber << ":\n";
        for (const auto& t : history)
            t.display();
        cout << endl;
    }

    void display() const {
        cout << fixed << setprecision(2);
        cout << "Account " << accountNumber << " | Balance: Rs" << balance << endl;
    }
};
int Account::nextAccNo = 1000;

// Customer Class
class Customer {
public:
    string name;
    int id;
    Account account;

    Customer(int i, const string &n) : id(i), name(n) {}

    void display() const {
        cout << "\nCustomer ID: " << id << ", Name: " << name << endl;
        account.display();
    }
};

// Main Program
int main() {
    Customer c1(1, "Aruna");
    Customer c2(2, "Devi");

    int choice;
    double amount;

    do {
        cout << "\n========== Simple Bank Menu ==========\n";
        cout << "1. Deposit (Aruna)\n2. Withdraw (Aruna)\n3. Transfer to Devi\n";
        cout << "4. Show Aruna Account\n5. Show Devi Account\n6. Show Transactions\n7. Exit\n";
        cout << "Choose an option: ";
        cin >> choice;

        switch(choice) {
            case 1:
                cout << "Enter deposit amount: Rs ";
                cin >> amount;
                c1.account.deposit(amount);
                break;
            case 2:
                cout << "Enter withdraw amount: Rs ";
                cin >> amount;
                c1.account.withdraw(amount);
                break;
            case 3:
                cout << "Enter amount to transfer to Devi: Rs ";
                cin >> amount;
                c1.account.transfer(c2.account, amount);
                break;
            case 4:
                c1.display();
                break;
            case 5:
                c2.display();
                break;
            case 6:
                c1.account.showHistory();
                c2.account.showHistory();
                break;
            case 7:
                cout << "Thank you for using the banking system." << endl;
                break;
            default:
                cout << "Invalid option. Try again." << endl;
        }
    } while (choice != 7);

    return 0;
}
